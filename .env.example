# Copy to .env and fill in.  NEVER commit the real .env file.

# NVIDIA NIM / build.nvidia.com API key - used by both the LLM and the VLM
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Qdrant - leave blank for a local unauthenticated instance
QDRANT_API_KEY=

# Elasticsearch basic auth - leave blank if security is disabled
ES_USER=
ES_PASSWORD=

# Optional: an API key instead of user/password
ES_API_KEY=

# Optional: separate key for an OpenAI-compatible VLM endpoint.
# Falls back to NVIDIA_API_KEY when unset.
VLM_API_KEY=

# Primary multimodal model. Both VLM_MODEL (canonical) and the legacy
# VLM_model spelling are accepted by the backend.
VLM_MODEL=moonshotai/kimi-k3
